# Copiar este archivo a .env y cambiar las contraseñas. El .env NO se sube a Git.

# PostgreSQL
PG_HOST=localhost
PG_PORT=5433
PG_DB=cineconecta
PG_ADMIN_USER=cine_admin
PG_ADMIN_PASSWORD=cambiar
PG_APP_USER=cineconecta_app
PG_APP_PASSWORD=cambiar
PG_REPORT_USER=cineconecta_report
PG_REPORT_PASSWORD=cambiar

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_DB=cineconecta
MONGO_ADMIN_USER=mongo_admin
MONGO_ADMIN_PASSWORD=cambiar
MONGO_APP_USER=cineconecta_app
MONGO_APP_PASSWORD=cambiar

# JWT (cadena larga y aleatoria, mínimo 32 caracteres)
JWT_SECRET=cambiar_por_una_cadena_larga_y_aleatoria_de_32_o_mas_caracteres
JWT_EXPIRATION_MINUTES=120
